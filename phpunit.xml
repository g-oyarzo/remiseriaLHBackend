<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Valores exclusivos de test (no son secretos de ningún entorno):
             permiten correr la suite sin un .env local. -->
        <env name="APP_KEY" value="base64:dGVzdC1rZXktcmVtaXNlcmlhLWxoLXNvbG8tdGVzdHM="/>
        <env name="REVERB_APP_ID" value="test-app"/>
        <env name="REVERB_APP_KEY" value="test-key"/>
        <env name="REVERB_APP_SECRET" value="test-secret"/>
        <env name="REVERB_HOST" value="localhost"/>
        <env name="REVERB_PORT" value="8080"/>
        <env name="REVERB_SCHEME" value="http"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- reverb en lugar de null: NullBroadcaster.auth() es un no-op que siempre
             devuelve 200 y nunca evalúa los closures de channels.php. Con reverb
             (PusherBroadcaster) los closures sí se ejecutan y el 403 se genera
             correctamente. Los tests que usan Event::fake() siguen funcionando. -->
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_HOST" value="mysql"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="remiserialh_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value="password"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Las difusiones en tiempo real se descartan (ver config/queue.php). -->
        <env name="DIFUSION_CONEXION_COLA" value="descartar" force="true"/>
        <!-- Último ping GPS en memoria (sin depender de Redis). -->
        <env name="UBICACION_CACHE_STORE" value="array" force="true"/>
        <!-- Los tests nunca deben llamar a un servicio de mapas real. -->
        <env name="MAPAS_DRIVER" value="ninguno" force="true"/>
        <env name="CLIMA_DRIVER" value="ninguno" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>