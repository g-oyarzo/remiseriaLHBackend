# NGINX: único servicio expuesto a Internet (80/443). Termina TLS, sirve
# la API (PHP-FPM) y hace de proxy de WebSockets hacia Reverb. MySQL, Redis,
# Reverb y PHP-FPM solo escuchan en la red interna de Docker.
#
# Variables (envsubst de la imagen oficial de nginx): ${SERVER_NAME},
# ${NGINX_LIMITE_API_RPS}, ${NGINX_RAFAGA_API} y ${NGINX_CONEXIONES_WS_POR_IP}
# (valores por defecto en compose.prod.yaml).

limit_req_zone $binary_remote_addr zone=api_por_ip:10m rate=${NGINX_LIMITE_API_RPS}r/s;
limit_req_zone $binary_remote_addr zone=webhook_por_ip:1m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=conexiones_por_ip:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Sin keepalive hacia PHP-FPM: FPM no multiplexa conexiones, y una conexión
# persistente deja a un proceso del pool atado a NGINX aunque esté ocioso.
# En la prueba de carga eso agotó el pool (504 en broadcasting/auth).
upstream php_fpm {
    server app:9000;
}

upstream reverb {
    server reverb:8080;
}

# Salud de NGINX para el healthcheck del contenedor: solo escucha en el
# loopback del contenedor, sin depender del dominio público.
server {
    listen 127.0.0.1:8081;
    server_name _;
    access_log off;
    location = /nginx-salud {
        return 200 "ok";
    }
    location / {
        return 404;
    }
}

# Seguridad (SEC-07): hosts desconocidos se descartan sin respuesta. Así el
# encabezado Host que llega a Laravel siempre es SERVER_NAME.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    # Validación de Let's Encrypt (certbot webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 4m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;

    root /var/www/html/public;
    index index.php;

    # Archivos ocultos (.env, .git, etc.): nunca.
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # WebSockets de Reverb (protocolo Pusher: /app/{key}). La API HTTP de
    # publicación de Reverb (/apps/{id}/...) NO se expone (SEC-10): el backend
    # publica por la red interna (REVERB_HOST=reverb).
    location ^~ /apps/ {
        return 404;
    }

    location ^~ /app/ {
        proxy_pass http://reverb;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        limit_conn conexiones_por_ip ${NGINX_CONEXIONES_WS_POR_IP};
    }

    location = /api/v1/webhooks/mercadopago {
        limit_req zone=webhook_por_ip burst=20 nodelay;
        try_files $uri /index.php?$query_string;
    }

    location / {
        limit_req zone=api_por_ip burst=${NGINX_RAFAGA_API} nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.php {
        fastcgi_pass php_fpm;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 35s;
    }

    # Ningún otro .php es ejecutable.
    location ~ \.php$ {
        return 404;
    }
}
