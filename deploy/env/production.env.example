# =============================================================================
# Plantilla de variables para PRODUCCIÓN (compose.prod.yaml).
#
#   cp deploy/env/production.env.example .env.production
#   chmod 600 .env.production
#
# NUNCA versionar .env.production (está en .gitignore). Todo valor marcado
# con <...> se completa en el servidor. Generar secretos con:
#   openssl rand -base64 32        (contraseñas)
#   docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
# =============================================================================

# Archivo que compose.prod.yaml carga en los contenedores (debe ser este mismo).
RLH_ENV_FILE=.env.production

APP_NAME="Remiseria LH"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<base64:... generado con key:generate --show>
APP_URL=https://<dominio-api>
APP_TIMEZONE=America/Argentina/Buenos_Aires
# "es" requiere traducciones en lang/es (no existen todavía): sin ellas los
# errores de validación salen como claves ("validation.required").
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

# Dominio que atiende NGINX (certificado de Let's Encrypt).
SERVER_NAME=<dominio-api>
NGINX_PLANTILLA=produccion.conf.template

# Logs a stderr: Docker los rota (10 MB x 5 por servicio).
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de datos (contenedor mysql; para RDS/MySQL administrado, cambiar DB_HOST)
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=remiseria_lh
DB_USERNAME=remiseria
DB_PASSWORD=<contraseña larga>
DB_ROOT_PASSWORD=<otra contraseña larga>
# Memoria de InnoDB: ~25 % de la RAM en la VM compartida de 12 GB.
MYSQL_BUFFER_POOL=2G

# --- Redis (cache, colas, último ping GPS, cuotas de mapas, Reverb scaling)
REDIS_CLIENT=phpredis
REDIS_PORT=6379
REDIS_PASSWORD=<contraseña larga>
REDIS_MAXMEMORY=768mb
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Espera bloqueante del worker (BLPOP): entrega inmediata de los eventos.
REDIS_QUEUE_BLOCK_FOR=5
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
UBICACION_CACHE_STORE=redis
MAPAS_CACHE_STORE=redis

# --- Reverb (WebSockets). El backend publica a Reverb por la red interna;
# los frontends se conectan a wss://<dominio-api>/app/<REVERB_APP_KEY> (NGINX).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<id>
REVERB_APP_KEY=<clave pública, la usan los frontends>
REVERB_APP_SECRET=<secreto, solo backend>
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Dominios del panel web (sin "*"). Ver nota sobre apps móviles en
# docs/DESPLIEGUE_ORACLE_CLOUD.md.
REVERB_ALLOWED_ORIGINS=<panel.dominio>
# Activar solo si se corre más de una instancia de Reverb.
REVERB_SCALING_ENABLED=false

# --- Seguridad HTTP
CORS_ALLOWED_ORIGINS=https://<panel.dominio>
SANCTUM_STATEFUL_DOMAINS=<panel.dominio>
SANCTUM_TOKEN_EXPIRATION=1440
BCRYPT_ROUNDS=12
# Subred interna de compose.prod.yaml (NGINX). La define el compose.
# TRUSTED_PROXIES=172.30.0.0/24
L5_SWAGGER_GENERATE_ALWAYS=false

# --- Mapas: openrouteservice (plan Standard gratuito, sin facturación)
MAPAS_DRIVER=ors
ORS_API_KEY=<clave de account.heigit.org>
ORS_URL=https://api.heigit.org/openrouteservice
MAPAS_TIMEOUT_SEGUNDOS=3
MAPAS_REINTENTOS=1
MAPAS_CACHE_MINUTOS=10
MAPAS_ORS_CUOTA_POR_MINUTO=35
MAPAS_ORS_CUOTA_POR_DIA=1900
MAPAS_RECHAZAR_SIN_RUTA=true
# Alternativa con facturación (NO activar sin autorización y sin tope de cuota):
# MAPAS_DRIVER=google
# GOOGLE_MAPS_API_KEY=
# MAPAS_GOOGLE_CUOTA_POR_MES=9500

# --- Clima: sin proveedor (no se contrata ningún plan)
CLIMA_DRIVER=ninguno

# --- Mercado Pago. Producción SOLO tras validar todo en sandbox
# (docs/seguridad-y-despliegue.md). Hasta entonces dejar vacío el token:
# los cobros digitales quedan deshabilitados (503) y se cobra en efectivo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://<dominio-api>/api/v1/webhooks/mercadopago
MERCADOPAGO_SANDBOX=false
MERCADOPAGO_WEBHOOK_TOLERANCIA_SEGUNDOS=900
MERCADOPAGO_PAGOS_AUTOMATICOS=false
MERCADOPAGO_REINTEGRO_AUTOMATICO=false

# --- Correo (no se usa en los flujos actuales)
MAIL_MAILER=log

# --- Backups (deploy/backup/README.md). El archivo de clave NO va en este .env.
BACKUP_RCLONE_DESTINO=oci:remiseria-backups
BACKUP_RETENCION_LOCAL_DIAS=7
BACKUP_RETENCION_REMOTA_DIAS=30
