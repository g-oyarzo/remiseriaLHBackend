APP_NAME="Remiseria LH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# El negocio opera en Argentina (UTC-3). No dejar en UTC: afecta fecha_viaje,
# vigencia de tarifas, fecha_pago y validaciones after_or_equal:now.
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Factor de corrección aplicado a la distancia en línea recta (Haversine)
# entre origen y destino para aproximar la distancia real de manejo, hasta
# que se integre una API de ruteo real (Google Maps Routes, OSRM, etc.).
DISTANCIA_FACTOR_CORRECCION=1.4

# Servicio de ruteo del cotizador (CU 02): osrm | google | ninguno.
# Con "ninguno" (valor por defecto si no se define) no se envían coordenadas a
# terceros y toda cotización usa la contingencia por zonas tarifarias.
# El servidor público de OSRM sirve solo para desarrollo (su política de uso no
# admite producción y recibe las coordenadas de los pasajeros): en producción
# usar una instancia propia de OSRM o Google Routes API.
MAPAS_DRIVER=osrm
MAPAS_OSRM_URL=https://router.project-osrm.org
# GOOGLE_MAPS_API_KEY=
MAPAS_TIMEOUT_SEGUNDOS=3
MAPAS_REINTENTOS=1
MAPAS_CACHE_MINUTOS=10

# Minutos de anticipación con los que un viaje "programado" empieza a
# notificarse/mostrarse a conductores disponibles antes de su fecha_viaje.
VENTANA_DESPACHO_PROGRAMADOS_MINUTOS=15

# --- Reglas operativas (ver config/remiseria.php; valores por defecto) ------
# Reservas: anticipación mínima (minutos) y máxima (días).
RESERVA_ANTICIPACION_MINIMA_MINUTOS=30
RESERVA_ANTICIPACION_MAXIMA_DIAS=30
# Cotización: trayectos más cortos/largos (línea recta) se rechazan.
COTIZACION_DISTANCIA_MINIMA_METROS=50
COTIZACION_DISTANCIA_MAXIMA_KM=300
# Asignación automática de conductores (CU 03).
ASIGNACION_TIEMPO_ACEPTACION_SEGUNDOS=30
ASIGNACION_RADIO_BUSQUEDA_METROS=10000
ASIGNACION_UBICACION_VIGENCIA_SEGUNDOS=120
ASIGNACION_MAX_OFERTAS=10
ASIGNACION_REINTENTO_SEGUNDOS=30
ASIGNACION_MAX_REINTENTOS=20
ASIGNACION_CALIFICACION_SIN_HISTORIAL=4.0
ASIGNACION_PESO_DISTANCIA_KM=1.0
ASIGNACION_PESO_CALIFICACION=0.5
ASIGNACION_PESO_ANTIGUEDAD_ANIO=0.1
ASIGNACION_PESO_VIAJE_DEL_DIA=0.2
# Geolocalización: store del último ping (Redis), persistencia en MySQL y
# validaciones de plausibilidad. Sin Redis se usa MySQL como respaldo.
UBICACION_CACHE_STORE=redis
UBICACION_TTL_SEGUNDOS=600
UBICACION_PERSISTIR_CADA_SEGUNDOS=15
UBICACION_VELOCIDAD_MAXIMA_KMH=200
UBICACION_SALTO_MINIMO_METROS=10
UBICACION_PRECISION_MAXIMA_METROS=50
# Finalización: geocerca del destino y vigencia de la última ubicación.
FINALIZACION_RADIO_TOLERANCIA_METROS=100
FINALIZACION_UBICACION_VIGENCIA_SEGUNDOS=60
FINALIZACION_MINIMO_PUNTOS_SEGUIMIENTO=3
# Reportes: rango máximo de fechas y filas exportables.
REPORTES_RANGO_MAXIMO_DIAS=366
REPORTES_MAX_FILAS_EXPORTACION=5000
# Límites de frecuencia (solicitudes por minuto por usuario).
RATE_LIMIT_API=120
RATE_LIMIT_UBICACION=60
RATE_LIMIT_CHAT=30
RATE_LIMIT_COTIZAR=30
RATE_LIMIT_VIAJES=10
RATE_LIMIT_PAGOS=20
RATE_LIMIT_REPORTES=10
# Conexión de cola para las difusiones por WebSocket (vacío = QUEUE_CONNECTION).
# DIFUSION_CONEXION_COLA=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Con Docker/Sail usar 'mysql' (nombre del servicio en compose.yaml).
# Con entorno nativo (XAMPP/Laragon) usar '127.0.0.1'.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=remiseria_lh
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# HALL-019: requiere un worker corriendo (ver servicio "queue" en
# compose.yaml, o supervisord/systemd en un servidor tradicional). Bajo
# volumen alto (sección 7 de la auditoría, "Gran escala") considerar migrar
# a QUEUE_CONNECTION=redis, que ya está disponible como servicio.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Con Docker/Sail usar 'redis' (nombre del servicio en compose.yaml).
# Con entorno nativo usar '127.0.0.1'.
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Contraseña del administrador creado por AdminSeeder. Si se omite, se genera
# una contraseña aleatoria y se imprime una única vez al correr el seeder.
# NUNCA dejar el valor por defecto 'password' en producción.
# ADMIN_PASSWORD=

# Laravel Reverb (servidor de WebSockets). REVERB_APP_ID/KEY/SECRET se generan
# con `php artisan install:broadcasting` o se definen manualmente.
REVERB_APP_ID=remiseria-lh
REVERB_APP_KEY=reverb-key
REVERB_APP_SECRET=reverb-secret
# Con Docker/Sail el servidor Reverb corre dentro del contenedor laravel.test.
# Desde el host (navegador/app móvil) acceder por localhost:8080.
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Orígenes permitidos para conexiones WebSocket, separados por comas.
# En producción reemplazar '*' por los dominios reales del frontend.
REVERB_ALLOWED_ORIGINS=*

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum
SANCTUM_TOKEN_EXPIRATION=1440
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1"

# CORS: orígenes del panel web separados por comas. En producción listar los
# dominios reales en lugar de "*".
CORS_ALLOWED_ORIGINS=*

# L5-Swagger / OpenAPI
L5_SWAGGER_CONST_HOST="${APP_URL}/api/v1"
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_DARK_MODE=false